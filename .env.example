# =============================================================================
# VIGIA — variaveis de ambiente
# Copie este arquivo para `.env` e preencha com os valores reais.
# NUNCA versione o `.env`.
# =============================================================================

# --- Banco de dados -----------------------------------------------------------
# As duas primeiras URLs usam o role de runtime (`vigia_app`) e apontam para o
# MESMO banco: pooled para a aplicacao, direta para ferramentas/CLI quando
# necessario. A superuser fica so no terminal local para migrations.
# Ver a secao "Migrations" do README.

# Usada pela aplicacao em runtime e pelo Prisma Client. Em producao/Supabase,
# use a URL pooled do Supavisor em modo transacao:
# postgresql://vigia_app.[project-ref]:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL=

# Conexao direta/session-mode na porta 5432, com a mesma credencial do
# `DATABASE_URL`, sem `pgbouncer=true`. Fica disponivel para ferramentas que
# precisam evitar o pooler de transacao.
DIRECT_DATABASE_URL=

# Usada SOMENTE por scripts/run-with-superuser.mjs, durante migrations.
# O script aponta a CLI do Prisma para este valor no processo filho, porque
# migrations sao DDL e o role de runtime nao tem privilegio de CREATE/ALTER/DROP.
# NUNCA e importada pelo codigo da aplicacao e nunca chega ao bundle do Next.
# No Supabase, use a conexao direta/5432 do role `postgres`, com CREATEDB.
DATABASE_SUPERUSER_URL=

# --- Sessao (iron-session) ----------------------------------------------------
# Segredo usado para assinar/criptografar o cookie de sessao.
# Precisa ter no minimo 32 caracteres.
# Gere um com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# (Opcional) Duracao da sessao em horas. Padrao: 8.
# SESSION_TTL_HOURS=8

# --- Vercel Cron --------------------------------------------------------------
# Segredo usado para proteger a rota do relatorio semanal.
# Na Vercel, configure esta env var para que o Cron envie:
# Authorization: Bearer $CRON_SECRET
CRON_SECRET=

# --- Usuario administrativo (scripts/create-admin.ts) -------------------------
# Lidas SOMENTE pelo `npm run create-admin`, que cria ou atualiza um usuario
# ativo com papel "admin" (redefine a senha, reativa a conta e regrava o papel
# se o username ja existir).
# Nao sao usadas pela aplicacao em runtime — podem ficar fora do .env e ser
# passadas na linha de comando:
#   ADMIN_USERNAME=admin ADMIN_PASSWORD=... npm run create-admin
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# --- Usuario da recepcao (scripts/create-recepcao.ts) -------------------------
# Mesmo contrato do bloco acima, mas grava papel "recepcao". As variaveis sao
# separadas de proposito: reaproveitar ADMIN_* deixaria ambiguo qual conta o
# comando esta criando ou atualizando.
#   RECEPCAO_USERNAME=recepcao RECEPCAO_PASSWORD=... npm run create-recepcao
# RECEPCAO_USERNAME=recepcao
# RECEPCAO_PASSWORD=

# --- E-mail / relatorio semanal (Resend) --------------------------------------
# Chave de API do Resend, usada para enviar o relatorio semanal.
RESEND_API_KEY=

# Destinatario(s) do relatorio semanal. Separe multiplos por virgula.
REPORT_EMAIL_TO=

# Remetente do relatorio semanal. O dominio precisa estar verificado no Resend.
# Formato aceito: "VIGIA <relatorios@seudominio.com.br>" ou apenas o endereco.
REPORT_EMAIL_FROM=
