# =============================================================================
# klini — variaveis de ambiente
# Copie este arquivo para `.env` e preencha com os valores reais.
# NUNCA versione o `.env`.
# =============================================================================

# --- Banco de dados -----------------------------------------------------------
# Os dois papeis abaixo apontam para o MESMO banco e mudam apenas o usuario.
# Ver a secao "Migrations" do README.

# Usada pela aplicacao em runtime e pelo Prisma Client.
# Deve ser um role RESTRITO: SELECT/INSERT/UPDATE/DELETE nas tabelas, USAGE no
# schema, e nenhum privilegio de DDL (sem CREATE/ALTER/DROP). Se a aplicacao for
# comprometida, o atacante nao consegue alterar o schema.
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO?schema=public
DATABASE_URL=

# Usada SOMENTE por scripts/run-with-superuser.mjs, durante migrations.
# O script sobrescreve DATABASE_URL com este valor no processo filho, porque a
# CLI do Prisma le DATABASE_URL para saber onde aplicar as migrations — e o role
# restrito nao tem privilegio de DDL.
# NUNCA e importada pelo codigo da aplicacao e nunca chega ao bundle do Next.
# Precisa apontar para o MESMO banco do DATABASE_URL, so que com o usuario
# privilegiado; apontar para outro banco migra o banco errado em silencio.
# Formato: postgresql://SUPERUSUARIO:SENHA@HOST:PORTA/BANCO?schema=public
DATABASE_SUPERUSER_URL=

# (Opcional) Shadow database do `prisma migrate dev`, usado para detectar drift.
# Deixe vazio no caso normal: rodando via run-with-superuser.mjs o Prisma cria e
# derruba um shadow temporario sozinho.
# Preencha apenas se o usuario de migration nao puder criar bancos (CREATEDB).
# ATENCAO: aponte para um banco DEDICADO e vazio — com shadow explicito o Prisma
# APAGA o schema desse banco a cada `migrate dev`. Nunca reaproveite aqui a URL
# do banco da aplicacao.
# SHADOW_DATABASE_URL=

# --- Sessao (iron-session) ----------------------------------------------------
# Segredo usado para assinar/criptografar o cookie de sessao.
# Precisa ter no minimo 32 caracteres.
# Gere um com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# (Opcional) Duracao da sessao em horas. Padrao: 8.
# SESSION_TTL_HOURS=8

# --- E-mail / relatorio semanal (Resend) --------------------------------------
# Chave de API do Resend, usada para enviar o relatorio semanal.
RESEND_API_KEY=

# Destinatario(s) do relatorio semanal. Separe multiplos por virgula.
REPORT_EMAIL_TO=

# Remetente do relatorio semanal. O dominio precisa estar verificado no Resend.
# Formato aceito: "klini <relatorios@seudominio.com.br>" ou apenas o endereco.
REPORT_EMAIL_FROM=
