// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Paciente. O nome e sempre trimado antes de salvar/buscar e e unico
/// case-insensitive no banco — o indice `UNIQUE (lower(nome))` nao e
/// expressavel no schema Prisma, ele vive na migration
/// `20260828120100_indices_e_constraints_manuais`.
model Paciente {
  id   Int    @id @default(autoincrement())
  nome String

  requisicoes    Requisicao[]
  /// Singular e opcional de proposito: `encaminhamento.paciente_id` e UNIQUE,
  /// entao a relacao e 1-para-no-maximo-1. Cadastrar um encaminhamento novo
  /// substitui o anterior.
  encaminhamento Encaminhamento?
  autorizacaoSulamerica AutorizacaoSulamerica?

  @@index([nome])
  @@map("paciente")
}

/// Encaminhamento medico de um paciente.
///
/// `data_vencimento` NAO e um campo comum: e uma coluna gerada pelo Postgres
/// (`(data_encaminhamento + INTERVAL '180 days')::date`, ver a migration
/// `20260909130000_encaminhamento`). A regra dos 180 dias corridos vive so no
/// banco, do mesmo jeito que o saldo/status de guia vive so na view
/// `requisicao_terapia_saldo` — nenhum TypeScript recalcula esse vencimento.
///
/// O Prisma nao tem sintaxe para coluna gerada, entao a declaracao abaixo e o
/// mais perto que da para chegar — e ela precisa ser exatamente essa, senao o
/// proximo `migrate dev` gera uma migration quebrada:
///
///   * `@default(dbgenerated(...))` com a expressao **literalmente como o
///     Postgres a normaliza**. A introspeccao le a expressao de geracao do
///     `pg_attrdef` e a devolve como se fosse um default; sem ela aqui, o
///     `migrate dev` diff-a schema contra banco, ve um default sobrando e
///     escreve `ALTER COLUMN "data_vencimento" DROP DEFAULT` — comando que o
///     Postgres recusa em coluna gerada (o correto seria `DROP EXPRESSION`).
///     Isso foi observado, nao suposto. Se a expressao da migration mudar, este
///     texto tem de mudar junto; `prisma db pull --print` mostra a forma exata.
///   * `DateTime?` (opcional) para bater com a coluna NULLABLE do banco e nao
///     entrar nos campos obrigatorios do `create`. Na pratica ela nunca e nula.
///
/// Escrever nela nao e "desaconselhado", e impossivel: o `GENERATED ALWAYS` faz
/// o Postgres recusar o INSERT/UPDATE, e ha teste de integracao afirmando isso.
/// O cadastro usa SQL cru com `RETURNING`, e as leituras trazem as duas datas
/// como texto "AAAA-MM-DD".
///
/// `pacienteId` e **unico**: um paciente tem no maximo um encaminhamento, e
/// cadastrar outro substitui o anterior (migration
/// `20260909140000_encaminhamento_unico_por_paciente`). O `@unique` aqui nao e
/// so documentacao — e o indice que da arbitro ao `ON CONFLICT ("paciente_id")`
/// do upsert em `lib/domain/encaminhamentos.ts`. Ele substitui o `@@index`
/// antigo: indice unico ja serve de indice de busca, manter os dois seria
/// pagar duas vezes.
///
/// O status de vencimento (Vencido / Vence este mes / A vencer / nenhum) nao
/// aparece aqui: ele e comparacao de **mes de calendario** e vive na view
/// `encaminhamento_status`, do mesmo jeito que saldo e status_alerta vivem na
/// view `requisicao_terapia_saldo` e nao no modelo da guia.
model Encaminhamento {
  id                 Int       @id @default(autoincrement())
  pacienteId         Int       @unique @map("paciente_id")
  dataEncaminhamento DateTime  @map("data_encaminhamento") @db.Date
  dataVencimento     DateTime? @default(dbgenerated("((data_encaminhamento + '180 days'::interval))::date")) @map("data_vencimento") @db.Date

  paciente Paciente @relation(fields: [pacienteId], references: [id])

  @@map("encaminhamento")
}

/// Usuario do sistema.
///
/// **Esta entidade mudou de premissa em 17/09/2026.** Ate entao o CONTEXT.md
/// afirmava que nao havia distincao de perfil — so "autenticado e ativo" ou
/// "nao autenticado". Agora todo usuario tem um `papel`.
///
/// `papel` e `String` aqui, mas nao e texto livre no banco: a migration
/// `20260917120000_papel_de_usuario` poe um
/// `CHECK (papel IN ('admin', 'recepcao'))` na coluna. O Prisma nao expressa
/// CHECK no schema, pelo mesmo motivo que o `UNIQUE (lower(nome))` de
/// `paciente` vive so na migration. O espelho em TypeScript do conjunto de
/// valores e `PapelUsuario` em `lib/auth/papel.ts`, e os tres tem de mudar
/// juntos.
///
/// **Sem `@default` de proposito.** A migration cria a coluna com
/// `DEFAULT 'admin'` apenas para backfillar as linhas que ja existiam (todas
/// elas eram admin) e derruba o default no mesmo arquivo. Declarar um default
/// permanente faria toda insercao nova que esquecesse o papel virar admin em
/// silencio — exatamente o erro que este campo existe para impedir. Sendo
/// obrigatorio e sem default, o TypeScript cobra o `papel` em todo `create`.
model Usuario {
  id           Int     @id @default(autoincrement())
  username     String  @unique
  passwordHash String  @map("password_hash")
  ativo        Boolean @default(true)
  papel        String

  @@map("usuario")
}

/// Terapia oferecida pela clinica.
model Terapia {
  id         Int    @id @default(autoincrement())
  nome       String @unique
  codigoTiss String @map("codigo_tiss")

  guias RequisicaoTerapia[]

  @@map("terapia")
}

/// Requisicao (autorizacao) de um paciente. `numero_requisicao` e unico
/// por paciente, nao globalmente.
model Requisicao {
  id               Int    @id @default(autoincrement())
  numeroRequisicao String @map("numero_requisicao")
  pacienteId       Int    @map("paciente_id")

  paciente Paciente            @relation(fields: [pacienteId], references: [id])
  guias    RequisicaoTerapia[]

  @@unique([pacienteId, numeroRequisicao], map: "requisicao_paciente_id_numero_requisicao_key")
  @@index([numeroRequisicao])
  @@index([pacienteId])
  @@map("requisicao")
}

/// "Guia": o cruzamento de uma requisicao com uma terapia, com a quantidade
/// autorizada. Os campos calculados (qtd_utilizada, saldo_restante,
/// creditos_por_sessao, status_alerta) NAO ficam aqui — sao lidos da view
/// SQL `requisicao_terapia_saldo`.
model RequisicaoTerapia {
  id            Int       @id @default(autoincrement())
  qtdAutorizada Int       @map("qtd_autorizada")
  validade      DateTime? @db.Date
  requisicaoId  Int       @map("requisicao_id")
  terapiaId     Int       @map("terapia_id")

  requisicao   Requisicao    @relation(fields: [requisicaoId], references: [id])
  terapia      Terapia       @relation(fields: [terapiaId], references: [id])
  atendimentos Atendimento[]

  @@index([requisicaoId])
  @@index([terapiaId])
  @@map("requisicao_terapia")
}

/// Atendimento lancado contra uma guia. Apagar a guia apaga os atendimentos
/// filhos (ON DELETE CASCADE, regra de negocio 9).
model Atendimento {
  id                  Int      @id @default(autoincrement())
  dataAtendimento     DateTime @map("data_atendimento") @db.Date
  creditosConsumidos  Int      @default(1) @map("creditos_consumidos")
  observacao          String?
  requisicaoTerapiaId Int      @map("requisicao_terapia_id")

  requisicaoTerapia RequisicaoTerapia @relation(fields: [requisicaoTerapiaId], references: [id], onDelete: Cascade)

  @@index([requisicaoTerapiaId])
  @@map("atendimento")
}

/// Uma autorizacao por paciente. CHECK de prazo e coluna gerada vivem na migration.
/// Expressao copiada de prisma db pull --print: evita DROP DEFAULT invalido.
model AutorizacaoSulamerica {
  id             Int       @id @default(autoincrement())
  pacienteId     Int       @unique @map("paciente_id")
  dataInicio     DateTime  @map("data_inicio") @db.Date
  prazoMeses     Int       @map("prazo_meses")
  dataVencimento DateTime? @default(dbgenerated("((data_inicio + ((prazo_meses)::double precision * '1 mon'::interval)))::date")) @map("data_vencimento") @db.Date

  paciente Paciente @relation(fields: [pacienteId], references: [id], onDelete: Restrict)

  @@map("autorizacao_sulamerica")
}
